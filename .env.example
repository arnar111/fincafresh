# ───────────────────────────────────────────────────────────────
# Fincafresh: umhverfisbreytur
# Afritaðu þessa skrá yfir í ".env" og fylltu út.
# ATH: Flesta lykla (WooCommerce, Pikkoló, PostHog o.fl.) er líka hægt að
# slá inn í stjórnborðinu undir "Tengingar". Það sem er hér gengur framar.
# ───────────────────────────────────────────────────────────────

# Gagnagrunnur (Postgres). Á Netlify er þetta óþarft: Netlify Database setur NETLIFY_DB_URL sjálfkrafa.
# Á eigin vél: keyrðu "npm run db:local" og notaðu þessa slóð.
DATABASE_URL="postgres://postgres@localhost:5433/postgres?connection_limit=1"

# Leynilykill fyrir innskráningu og dulkóðun lykla (a.m.k. 32 stafir).
# Búðu til nýjan t.d. með:  openssl rand -base64 48
APP_SECRET="breyttu-mer-i-langan-handahofskenndan-streng-a-netthjoni"

# Fyrsti stjórnandi: búinn til við "npm run setup", eða við fyrstu innskráningu
# á nýjum netþjóni ef enginn stjórnandi er til (lykilorð a.m.k. 8 stafir).
ADMIN_EMAIL="fincafresh@fincafresh.is"
ADMIN_PASSWORD="breyttu-mer"

# Slóð síðunnar (notað í tölvupóstum og tenglum)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Pikkoló ────────────────────────────────────────────────────
# Umhverfi: staging (prófun) eða production (raunverulegar pantanir)
PIKKOLO_ENVIRONMENT="staging"
PIKKOLO_VENDOR_ID=""
PIKKOLO_API_KEY=""

# ── WooCommerce (REST API v3) ──────────────────────────────────
WOOCOMMERCE_URL=""
WOOCOMMERCE_CONSUMER_KEY=""
WOOCOMMERCE_CONSUMER_SECRET=""
WOOCOMMERCE_WEBHOOK_SECRET=""

# ── PostHog ────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
POSTHOG_PERSONAL_API_KEY=""
POSTHOG_PROJECT_ID=""

# ── Tölvupóstur (SMTP). Ef autt eru póstar vistaðir í "Útsendur póstur" í stjórnborði.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Fincafresh <fincafresh@fincafresh.is>"

# ── Adobe Fonts (valfrjálst): ef þið eigið leyfi fyrir Monarcha / Minion Pro
NEXT_PUBLIC_ADOBE_FONTS_KIT=""
